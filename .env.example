# OpenAI API Key (required) - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT Secret (auto-generated by setup.sh)
JWT_SECRET=your-random-secret-here

# YooKassa (required for payments) - Get from https://yookassa.ru/my/shop-settings
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App URL (change to your domain in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (auto-configured)
DATABASE_URL="file:./dev.db"
